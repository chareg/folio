{
  "name": "folio-reader",
  "productName": "Folio",
  "version": "1.1.0",
  "description": "A calm, beautiful reader for Word documents",
  "main": "main.js",
  "author": "Chare",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/chareg/folio.git" },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.folio.reader",
    "productName": "Folio",
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "fileAssociations": [{ "ext": "docx", "name": "Word Document", "description": "Word Document", "role": "Viewer" }],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-Setup-${version}.exe",
      "shortcutName": "Folio"
    },
    "publish": [{ "provider": "github", "owner": "chareg", "repo": "folio", "releaseType": "release" }]
  }
}
